#include "cache.h"


#define IP_TRACKER_COUNT 32
#define MASK_IP 0xFFFF

// longest non-uniform stride pattern we try to detect (PDF example (+1,+2,+2,+2,+3) has length 5)
#define MAX_PATTERN_LEN 6
// signature = last 2*MAX_PATTERN_LEN strides, enough to see the longest pattern twice
#define SIG_LEN (2*MAX_PATTERN_LEN)

// strides are kept within +-63 cache lines (a 4 KB page has 64 lines), so they fit in 7 bits;
// anything bigger can never produce an in-page prefetch and is ignored
#define MAX_STRIDE 63

// accuracy-based throttling: every EPOCH issued prefetches, recompute accuracy and pick a degree
#define EPOCH 256
#define MIN_DEGREE 1
#define MAX_DEGREE 6
#define START_DEGREE 2

class IP_TRACKER {
  public:
    // the IP we're tracking
    uint64_t ip;

    // the last address accessed by this IP
    uint64_t last_cl_addr;

    // signature: the recently observed strides of this IP, oldest first, newest at sig[SIG_LEN-1]
    int8_t sig[SIG_LEN];

    // number of valid strides in the signature
    uint32_t sig_count;

    // length of the non-uniform pattern currently being followed (0 = none)
    uint32_t pattern_len;

    // use LRU to evict old IP trackers
    uint32_t lru;

    IP_TRACKER () {
        ip = 0;
        last_cl_addr = 0;
        for (int i=0; i<SIG_LEN; i++)
            sig[i] = 0;
        sig_count = 0;
        pattern_len = 0;
        lru = 0;
    };
};

IP_TRACKER trackers[IP_TRACKER_COUNT];

// accuracy checker state: every L1D block has a prefetch bit; a demand hit on a block with the bit set
// is a useful prefetch (cache.cc counts these in pf_useful), and pf_lower_level counts prefetches that
// missed in L1D and were actually sent down. we sample both at the start of each epoch.
uint32_t spp_degree = START_DEGREE;
uint64_t epoch_start_issued = 0, epoch_start_useful = 0;
uint64_t uniform_predictions = 0, pattern_predictions = 0;

// does the last-p strides window of the signature repeat the p strides before it?
static bool pattern_matches(IP_TRACKER &t, uint32_t p)
{
    if (t.sig_count < 2*p)
        return false;

    for (uint32_t i=0; i<p; i++) {
        if (t.sig[SIG_LEN-1-i] != t.sig[SIG_LEN-1-i-p])
            return false;
    }
    return true;
}


void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
	for (int i=0; i<IP_TRACKER_COUNT; i++)
        	trackers[i].lru = i;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

	// check for a tracker hit
    ip = ip & MASK_IP;

    int index = -1;
    for (index=0; index<IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == ip)
            break;
    }

    // this is a new IP that doesn't have a tracker yet, so allocate one
    if (index == IP_TRACKER_COUNT) {

        for (index=0; index<IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT-1))
                break;
        }

        uint32_t old_lru = trackers[index].lru;
        trackers[index] = IP_TRACKER();
        trackers[index].lru = old_lru;
        trackers[index].ip = ip;
        trackers[index].last_cl_addr = cl_addr;

	for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;

        return;
    }

    IP_TRACKER &t = trackers[index];

    // calculate the stride between the current address and the last address
    int64_t stride = 0;
    if (cl_addr > t.last_cl_addr)
        stride = cl_addr - t.last_cl_addr;
    else {
        stride = t.last_cl_addr - cl_addr;
        stride *= -1;
    }

    // update LRU
    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < t.lru)
            trackers[i].lru++;
    }
    t.lru = 0;

    // same line twice in a row: nothing learnt
    if (stride == 0)
        return;

    t.last_cl_addr = cl_addr;

    // a jump bigger than a page can't be prefetched within the page, so keep it out of the signature
    if (stride > MAX_STRIDE || stride < -MAX_STRIDE)
        return;

    // push the stride into the signature
    for (int i=0; i<SIG_LEN-1; i++)
        t.sig[i] = t.sig[i+1];
    t.sig[SIG_LEN-1] = (int8_t)stride;
    if (t.sig_count < SIG_LEN)
        t.sig_count++;

    // pick the pattern to follow:
    //   1. uniform stride (pattern of length 1) has priority
    //   2. otherwise keep following the current non-uniform pattern if it still holds
    //   3. otherwise search for a repeating pattern, longest first (short ones can hide inside long ones)
    uint32_t p = 0;
    if (pattern_matches(t, 1)) {
        p = 1;
        uniform_predictions++;
    }
    else {
        if (t.pattern_len >= 2 && pattern_matches(t, t.pattern_len))
            p = t.pattern_len;
        else {
            t.pattern_len = 0;
            for (uint32_t len=MAX_PATTERN_LEN; len>=2; len--) {
                if (pattern_matches(t, len)) {
                    p = len;
                    break;
                }
            }
        }
        t.pattern_len = p;
        if (p)
            pattern_predictions++;
    }

    if (p == 0)
        return;

    // the signature maps to the next strides: after a pattern of length p, stride j comes from sig[SIG_LEN-p + j%p]
    uint64_t pf_cl_addr = cl_addr;
    for (uint32_t i=0; i<spp_degree; i++) {
        pf_cl_addr += t.sig[SIG_LEN - p + (i % p)];
        uint64_t pf_address = pf_cl_addr << LOG2_BLOCK_SIZE;

        // only issue a prefetch if the prefetch address is in the same 4 KB page
        // as the current demand access address
        if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
            break;

        // check the MSHR occupancy to decide if we're going to prefetch to the L1 or L2
        if (MSHR.occupancy < (MSHR.SIZE>>1))
            prefetch_line(ip, addr, pf_address, FILL_L1, 0);
        else
            prefetch_line(ip, addr, pf_address, FILL_L2, 0);
    }

    // accuracy-based throttling
    // (the stats are reset at the end of warmup, so restart the epoch if they went backwards)
    if (pf_lower_level < epoch_start_issued || pf_useful < epoch_start_useful) {
        epoch_start_issued = pf_lower_level;
        epoch_start_useful = pf_useful;
    }
    uint64_t epoch_issued = pf_lower_level - epoch_start_issued;
    if (epoch_issued >= EPOCH) {
        double accuracy = (double)(pf_useful - epoch_start_useful) / epoch_issued;
        if (accuracy >= 0.75)
            spp_degree = MAX_DEGREE;
        else if (accuracy >= 0.50)
            spp_degree = 4;
        else if (accuracy >= 0.25)
            spp_degree = 2;
        else
            spp_degree = MIN_DEGREE;
        epoch_start_issued = pf_lower_level;
        epoch_start_useful = pf_useful;
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
    cout << "CPU " << cpu << " L1D SPP final stats" << endl;
    cout << "SPP uniform predictions: " << uniform_predictions << " pattern predictions: " << pattern_predictions << endl;
    cout << "SPP final degree: " << spp_degree << endl;
}
