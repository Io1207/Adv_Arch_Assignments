#include "cache.h"

#define maxRRPV 3

#ifndef NUM_LEADERS
#define NUM_LEADERS 32
#endif
#define LEADER_STRIDE (L2C_SET / NUM_LEADERS)

#ifndef PSEL_BITS
#define PSEL_BITS 10
#endif
#define PSEL_MAX ((1 << PSEL_BITS) - 1)
#define PSEL_MID (1 << (PSEL_BITS - 1))

uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint32_t psel;

uint64_t rrip_leader_miss, irrip_leader_miss;

bool is_rrip_leader(uint32_t set)
{
    return (set % LEADER_STRIDE) == 0;
}

bool is_irrip_leader(uint32_t set)
{
    return (set % LEADER_STRIDE) == LEADER_STRIDE / 2;
}

bool use_irrip(uint32_t set)
{
    if (is_rrip_leader(set))
        return false;
    if (is_irrip_leader(set))
        return true;
    return psel >= PSEL_MID;
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize PSEL Dynamic I-RRIP state for L2C (NUM_LEADERS=" << NUM_LEADERS << " per policy, PSEL_BITS=" << PSEL_BITS << ")" << endl;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
    psel = PSEL_MID;
    rrip_leader_miss = irrip_leader_miss = 0;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    for (int i=0; i<L2C_WAY; i++)
        if (!current_set[i].valid)
            return i;

    bool irrip = use_irrip(set);

    while (1)
    {
        if (irrip)
            for (int i = 0; i < L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction)
                    return i;

        for (int i = 0; i < L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        for (int i = 0; i < L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    // a demand miss (this call is its fill) in a leader set moves PSEL by one
    if (!hit && type != WRITEBACK) {
        if (is_rrip_leader(set)) {          // RRIP missed -> lean towards I-RRIP
            if (psel < PSEL_MAX)
                psel++;
            rrip_leader_miss++;
        } else if (is_irrip_leader(set)) {  // I-RRIP missed -> lean towards RRIP
            if (psel > 0)
                psel--;
            irrip_leader_miss++;
        }
    }

    // I-RRIP promotes data hits only to 1 (best on every trace in Task 2a), RRIP promotes all hits to 0
    if (hit && use_irrip(set) && !isInstruction)
        l2_rrpv[set][way] = 1;
    else if (hit)
        l2_rrpv[set][way] = 0;
    else
        l2_rrpv[set][way] = maxRRPV - 1;
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "DYN-IRRIP final PSEL: " << psel << " / " << PSEL_MAX << endl;
    cout << "DYN-IRRIP leader misses: RRIP leaders " << rrip_leader_miss
         << "  I-RRIP leaders " << irrip_leader_miss << endl;
}
