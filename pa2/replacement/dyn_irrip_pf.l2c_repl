#include "cache.h"

#define maxRRPV 3

#ifndef NUM_LEADERS
#define NUM_LEADERS 64
#endif
#define LEADER_STRIDE (L2C_SET / NUM_LEADERS)

#ifndef EPOCH
#define EPOCH 4096
#endif

uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint64_t instr_acc, instr_miss, total_acc, total_miss, epoch_acc;

bool is_leader(uint32_t set)
{
    return (set % LEADER_STRIDE) == 0;
}

double instr_ratio()
{
    uint64_t denom = total_acc + total_miss;
    if (denom == 0)
        return 0.0;
    return (double)(instr_acc + instr_miss) / denom;
}

bool use_irrip(uint32_t set)
{
    return !is_leader(set) && instr_ratio() > 0.25;
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Prefetch-aware Dynamic I-RRIP state for L2C (THRESHOLD=0.25, NUM_LEADERS=" << NUM_LEADERS << ", EPOCH=" << EPOCH << ")" << endl;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
    instr_acc = instr_miss = total_acc = total_miss = epoch_acc = 0;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    for (int i=0; i<L2C_WAY; i++)
        if (!current_set[i].valid)
            return i;

    bool irrip = use_irrip(set);

    while (1)
    {
        if (irrip)
            for (int i = 0; i < L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction)
                    return i;

        for (int i = 0; i < L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        for (int i = 0; i < L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    if (is_leader(set) && type != WRITEBACK && type != PREFETCH) {
        total_acc++;
        if (isInstruction) instr_acc++;
        if (!hit) {
            total_miss++;
            if (isInstruction) instr_miss++;
        }
        if (++epoch_acc >= EPOCH) {
            instr_acc >>= 1; instr_miss >>= 1;
            total_acc >>= 1; total_miss >>= 1;
            epoch_acc = 0;
        }
    }

    if (type == PREFETCH) {
        if (!hit)
            l2_rrpv[set][way] = maxRRPV;
        return;
    }

    if (hit && use_irrip(set) && !isInstruction)
        l2_rrpv[set][way] = 1;
    else if (hit)
        l2_rrpv[set][way] = 0;
    else
        l2_rrpv[set][way] = maxRRPV - 1;
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "DYN-IRRIP final instr ratio: " << instr_ratio() << endl;
}
